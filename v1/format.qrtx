algtype formatval{
	strval(std::strview),
	ppack_idx(u32),

}

class hello{
	int i,b,c;
	int say_hello();
}
impl hello{
	int say_hello(){
		return self.i+self.b+self.c;
	}
}

varalias output_buffer = #core::output_buffer;

comptime std::vector<printfval> get_format_values(strlit fstring){
	std::vector<printfval> values;
	std::strview ccfstring =  fstring;

	
	u32 curr_f = 0;
	u32 curr_ppack_idx;
	for(u32 i = 0; fstring.size > i; i++){
		if(fstring[i]=='{'){
			values.push_back(formatval::strval(ccfstring.substring(curr_f,i-1)));
			
			i++;
			if(fstring[i]=='}'){
				values.push_back(formatval::ppack_idx(curr_ppack_idx));
				curr_ppack_idx++;
			}
			else{
				std::string result_str="";
				while(fstring[i]!='}'||fstring.size > i){
					result_str+=fstring[i];
					i++;
				}
				u32 idx = std::from_chars(result_str);
				values.push_back(formatval::ppack_idx(idx));
			}
			curr_f = i;
		}
	
}
	return values;
	
}

std::string format(strlit fstring,#param_pack ppack){
	comptime std::vector<printfval> values = get_format_values(fstring);
	std::string result;
	$for(formatval i :values){
		$match(i){
			case formatval::strval(strval):
				result+=strval;
			case formatval::ppack_idx(idx):
				result+=std::to_string(ppack[idx]);
		}
	
	}

}

void printf(strlit fstring,#param_pack ppack){
	output_buffer.write(format(fstring,ppack));
}