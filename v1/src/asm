};
using word_map = enum_to_type_map<AsmDataType>::map<
    type_map_elem<AsmDataType::byte,uint8_t>,
    type_map_elem<AsmDataType::word,uint16_t>,
    type_map_elem<AsmDataType::dword,uint32_t>,
    type_map_elem<AsmDataType::qword,uint64_t>
>;
template <AsmDataType t>
using AsmDataType_t = word_map::get_type<t> ;
enum class RegOfssetOp:uint8_t{
    sub,
    add
};
struct AsmLabelID{
    uint32_t id=0;
};
struct MemOperandDereference{
    union{
       AsmReg reg;
        struct{
            RegOfssetOp op;
            AsmReg reg;
            uint64_t value;
        } reg_ofsset;
        AsmLabelID label;;;
    };
};
template <AsmDataType t>
struct MemOperand{
    enum class type{
        reg,
        mem,
        constant,
        deref
    };

    type operand_type;
    union{
        AsmReg as_asm_reg;
        MemOperandDereference as_deref;
        AsmLabelID as_label;
        AsmDataType_t<t> as_constant;

    };
    
};

    enum class AsmOperation:uint8_t{
        mov,

        imul,
        mul,

        div,
        idiv,

        add,
        sub,
        mod,
        push,
        pop,
    };


struct BinIns{
    AsmOperation type;
    union{
        struct{
            MemOperand<AsmDataType::dword> left;
            MemOperand<AsmDataType::dword> right;
        }as_dword;
        struct{
            MemOperand<AsmDataType::word> left;
            MemOperand<AsmDataType::word> right;
        }as_word;
        struct{
            MemOperand<AsmDataType::qword> left;
            MemOperand<AsmDataType::qword> right;
        }as_qword;
        struct{
            MemOperand<AsmDataType::byte> left;
            MemOperand<AsmDataType::byte> right;
        }as_byte;
    };
};




struct UnIns{
   
    AsmOperation instruction_type;
    union{
        MemOperand<AsmDataType::dword> dword_operand;
        MemOperand<AsmDataType::word> word_operand;
        MemOperand<AsmDataType::qword> qword_operand;
        MemOperand<AsmDataType::byte> byte_operand;
    
    };
};


struct store_data{
    enum class type{
        db,
        dw,
        dd,
        dq
    };
    type t;
    std::vector<uint8_t> data;

};
enum class instruction_type:uint8_t{
    none,
    data,
    unary,
    binary,
};
struct Instruction{
Instruction():none{std::nullopt}{}
    instruction_type type;
    union{
        std::nullopt_t  none;
        store_data data;
        UnIns unary_instruction;
        BinIns binary_instruction;
        AsmLabelID declare_label;
    };
};



